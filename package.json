  "scripts": {
    "start:devmeta": "DISABLE_ESLINT_PLUGIN=true NODE_ENV=devmeta PORT=3005 react-app-rewired start",
    "start:testnet": "DISABLE_ESLINT_PLUGIN=true NODE_ENV=testnet PORT=3005 react-app-rewired start",
    "start:mainnet": "DISABLE_ESLINT_PLUGIN=true NODE_ENV=production PORT=3005 react-app-rewired start",
    "build": "echo \"Please use build:testnet or build:mainnet \" && exit 1",
    "build:devmeta": "CI=false DISABLE_ESLINT_PLUGIN=true dotenv -e .env.devmeta react-app-rewired build",
    "build:testnet": "CI=false DISABLE_ESLINT_PLUGIN=true dotenv -e .env.testnet react-app-rewired build",
    "build:mainnet": "CI=false DISABLE_ESLINT_PLUGIN=true dotenv -e .env.production react-app-rewired build",
